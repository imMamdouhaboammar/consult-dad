{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://consult-dad.dev/schemas/config.v1.json",
  "title": "ConsultDadConfig",
  "description": "Schema for Consult Dad project configuration (.consult-dad/config.json)",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "default_advisor": {
      "type": "string",
      "default": "staff"
    },
    "advisors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "adapter": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "priority": {
            "type": "integer",
            "default": 100
          }
        },
        "required": ["adapter"],
        "additionalProperties": false
      }
    },
    "escalation": {
      "type": "object",
      "properties": {
        "auto": {
          "type": "boolean",
          "default": true
        },
        "max_attempts_before_consult": {
          "type": "integer",
          "default": 2
        },
        "triggers": {
          "type": "object",
          "properties": {
            "architecture": { "type": "boolean", "default": true },
            "auth": { "type": "boolean", "default": true },
            "migrations": { "type": "boolean", "default": true },
            "destructive": { "type": "boolean", "default": true },
            "repeated_failure": { "type": "boolean", "default": true }
          },
          "additionalProperties": false
        },
        "max_consultations_per_task": {
          "type": "integer",
          "default": 3
        },
        "max_depth": {
          "type": "integer",
          "maximum": 1,
          "default": 1
        }
      },
      "additionalProperties": false
    },
    "timeout_ms": {
      "type": "integer",
      "default": 120000
    }
  },
  "additionalProperties": false
}
