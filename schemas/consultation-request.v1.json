{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://consult-dad.dev/schemas/consultation-request.v1.json",
  "title": "ConsultationRequest",
  "description": "Schema for initiating a consultation with Consult Dad",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "consult-dad.request.v1"
    },
    "consultation_id": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "mode": {
      "type": "string",
      "enum": [
        "consult",
        "diagnose",
        "review",
        "decide",
        "challenge",
        "takeover"
      ]
    },
    "caller": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "agent",
        "role"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "current_hypothesis": {
      "type": "string"
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "outcome"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "evidence": {
      "type": "object",
      "properties": {
        "failing_tests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "relevant_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "git_diff": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "file_contents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              },
              "truncated": {
                "type": "boolean",
                "default": false
              },
              "bytes_read": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "content"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "constraints": {
      "type": "object",
      "properties": {
        "read_only": {
          "type": "boolean",
          "default": true
        },
        "workspace_root": {
          "type": "string"
        },
        "max_followups": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "decision_needed": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "mode",
    "caller",
    "goal",
    "question",
    "decision_needed"
  ],
  "additionalProperties": false
}
